// ── Country configuration tables ──────────────────────────────────────────

model Country {
  code                     String  @id @db.VarChar(2)
  name                     String  @db.VarChar(100)
  region                   String  @db.VarChar(50)
  currency_code            String  @db.VarChar(3)
  currency_symbol          String  @db.VarChar(10)
  financial_year_start_month Int
  financial_year_type      String  @db.VarChar(10)
  date_format              String? @default("DD/MM/YYYY") @db.VarChar(20)
  timezone                 String? @default("UTC") @db.VarChar(50)
  tax_id_label             String  @db.VarChar(50)
  registration_id_label    String  @db.VarChar(50)
  created_at               DateTime? @default(now()) @db.Timestamptz

  document_types           CountryDocumentType[]
  entity_types             CountryEntityType[]
  compliance_categories    CountryComplianceCategory[]
  validation_rules         CountryValidationRule[]

  @@map("countries")
}

model CountryDocumentType {
  id            String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  country_code  String    @db.VarChar(2)
  document_type String    @db.VarChar(100)
  is_required   Boolean?  @default(false)
  display_order Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamptz

  country       Country   @relation(fields: [country_code], references: [code], onDelete: Cascade)

  @@unique([country_code, document_type])
  @@map("country_document_types")
}

model CountryEntityType {
  id                  String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  country_code        String    @db.VarChar(2)
  entity_type         String    @db.VarChar(100)
  display_name        String    @db.VarChar(100)
  requires_directors  Boolean?  @default(true)
  requires_shareholders Boolean? @default(false)
  display_order       Int?      @default(0)
  created_at          DateTime? @default(now()) @db.Timestamptz

  country             Country   @relation(fields: [country_code], references: [code], onDelete: Cascade)

  @@unique([country_code, entity_type])
  @@map("country_entity_types")
}

// Matches supabase/migrations/migration-country-config-tables.sql
// which is the authoritative definition. Earlier Prisma model omitted
// category_code / is_active / metadata — prisma db push --accept-data-loss
// dropped them in prod, which broke useComplianceCategories (it queries
// category_code and filters on is_active, got a 400 from PostgREST).
model CountryComplianceCategory {
  id            String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  country_code  String    @db.VarChar(2)
  category_code String    @db.VarChar(50)   // "tax" / "corporate" / "labor" / …
  category_name String    @db.VarChar(100)
  display_order Int?      @default(0)
  is_active     Boolean?  @default(true)
  metadata      Json?     @default("{}")
  created_at    DateTime? @default(now()) @db.Timestamptz

  country       Country   @relation(fields: [country_code], references: [code], onDelete: Cascade)

  @@unique([country_code, category_code])
  @@index([is_active])
  @@map("country_compliance_categories")
}

model CountryValidationRule {
  id                       String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  country_code             String    @db.VarChar(2)
  field_type               String    @db.VarChar(50)
  pattern                  String?   @db.VarChar(255)
  min_length               Int?
  max_length               Int?
  required                 Boolean?  @default(true)
  validation_function      String?
  error_message            String?
  verification_portal_url  String?
  verification_instructions String?
  metadata                 Json?     @default("{}")
  created_at               DateTime? @default(now()) @db.Timestamptz
  updated_at               DateTime? @default(now()) @db.Timestamptz

  country                  Country   @relation(fields: [country_code], references: [code], onDelete: Cascade)

  @@unique([country_code, field_type])
  @@map("country_validation_rules")
}
