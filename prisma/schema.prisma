generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AppUser {
  id               String         @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  primary_email    String
  full_name        String?
  password_hash    String?
  status           String         @default("active")
  email_verified   Boolean        @default(false)
  email_verified_at DateTime?     @db.Timestamptz
  created_at       DateTime       @default(now()) @db.Timestamptz
  updated_at       DateTime       @default(now()) @db.Timestamptz

  authIdentities AuthIdentity[]

  @@map("app_users")
}

model AuthIdentity {
  id             String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  app_user_id    String   @db.Uuid
  provider       String
  legacy_auth_id String?
  email          String?
  is_primary     Boolean  @default(false)
  metadata       Json     @default("{}")
  created_at     DateTime @default(now()) @db.Timestamptz

  appUser AppUser @relation(fields: [app_user_id], references: [id])

  @@map("auth_identities")
}

model Company {
  id                      String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  user_id                 String    @db.Uuid
  app_user_id             String?   @db.Uuid
  name                    String
  type                    String?
  tax_id                  String?
  registration_id         String?
  industry                String?
  industries              String[]
  industry_categories     String[]
  other_industry_category String?
  incorporation_date      DateTime? @db.Date
  address                 String?
  city                    String?
  state                   String?
  pin_code                String?
  phone_number            String?
  email                   String?
  landline                String?
  other_info              String?
  stage                   String?
  confidence_score        String?
  year_type               String?   @default("FY")
  country_code            String?   @default("IN") @db.VarChar
  region                  String?
  ex_directors            String[]
  nic_code                String?   @db.VarChar(5)
  is_listed               Boolean?
  employee_count          Int?
  annual_turnover         Decimal?  @db.Decimal(15, 2)
  is_gst_registered       Boolean?  @default(false)
  gst_number              String?   @db.VarChar(15)
  qrmp_eligible           Boolean?  @default(false)
  net_worth               Decimal?  @db.Decimal(15, 2)
  is_msme                 Boolean?
  msme_category           String?   @db.VarChar(10)
  has_imports_exports      Boolean?  @default(false)
  is_startup_dpiit        Boolean?  @default(false)
  authorised_capital      Decimal?  @db.Decimal(15, 2)
  paid_up_capital         Decimal?  @db.Decimal(15, 2)
  subscribed_capital      Decimal?  @db.Decimal(15, 2)
  company_category        String?
  company_subcategory     String?
  class_of_company        String?
  roc_name                String?
  company_status          String?
  date_of_last_agm        DateTime? @db.Date
  balance_sheet_date      DateTime? @db.Date
  // Country-specific metadata pulled from MCA / CIN lookups; kept as
  // free-form JSON so the shape can evolve without migrations.
  jurisdiction_metadata   Json?
  created_at              DateTime  @default(now()) @db.Timestamptz
  updated_at              DateTime  @default(now()) @db.Timestamptz

  requirements       RegulatoryRequirement[]
  notifications      CompanyNotification[]
  gst_registrations  GstRegistration[]

  @@map("companies")
}

model GstRegistration {
  id         String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id String   @db.Uuid
  gstin      String   @db.VarChar(15)
  state      String?
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, gstin])
  @@index([company_id])
  @@map("gst_registrations")
}

// These two "exclusions" tables were previously defined only in raw SQL
// migrations under supabase/migrations. Adding them here keeps
// prisma db push from drifting and ensures any future schema change
// goes through the same single source of truth.
model CompanyDocumentTemplateExclusion {
  id            String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id    String   @db.Uuid
  document_name String
  folder_name   String
  created_at    DateTime? @default(now()) @db.Timestamptz
  created_by    String?   @db.Uuid

  @@unique([company_id, document_name, folder_name])
  @@index([company_id])
  @@index([document_name])
  @@map("company_document_template_exclusions")
}

model CompanyComplianceExclusion {
  id             String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id     String   @db.Uuid
  requirement_id String   @db.Uuid
  created_at     DateTime? @default(now()) @db.Timestamptz
  created_by     String?   @db.Uuid

  @@unique([company_id, requirement_id])
  @@index([company_id])
  @@index([requirement_id])
  @@map("company_compliance_exclusions")
}

// ── Compliance Rule Catalogue ─────────────────────────────────────────────
// Versioned source of truth for every compliance obligation the tracker
// can raise. Replaces the hard-coded TS rule sets in
// lib/compliance/rules/sets/*. Each row is "rule X as in force from
// effectiveFrom to effectiveTo"; when an Act changes (e.g., IT Act 1961 →
// 2025 on 2026-04-01) we insert new rows rather than mutating old ones,
// so historical tracker renders stay correct.
//
// The companion CompanyFact + ComplianceAssessment tables (added in
// later phases) turn these rules into per-company applicability
// decisions driven by real facts, not just attribute guesses.
model ComplianceRule {
  // Stable logical id, e.g., "tds.return.q1@itact2025". Kept readable
  // because CAs will sometimes write SQL against this table.
  id                 String    @id

  category           String                              // RoC / GST / Income Tax / Payroll / ...
  name               String
  description        String?
  act                String                              // "Income Tax Act, 2025"
  section_ref        String                              // "Section 393"
  legacy_section_ref String?                             // "Section 200(3)" (when the rule supersedes an older section)
  authority          String                              // "Income Tax Department (TRACES)"
  frequency          String                              // monthly / quarterly / half-yearly / annual / one-time / event-based
  due_date_formula   String?
  due_description    String?
  penalty            String?
  is_critical        Boolean   @default(false)
  documents_required String[]  @default([])
  form_refs          Json?                               // { primary: "Form 140", legacy: ["24Q","26Q"] }
  source_url         String?

  // Temporal — the rule is in force during [effective_from, effective_to]
  effective_from     DateTime  @db.Date
  effective_to       DateTime? @db.Date

  // Act-transition chain so we can trace "this rule replaced that rule"
  supersedes_rule_id     String?
  superseded_by_rule_id  String?

  // Machine-readable applicability — lets the deterministic evaluator
  // decide yes/no/maybe from facts without needing an LLM for every rule.
  // triggerKind values:
  //   "always"             — always applies while entity matches entity_scope
  //   "payment_above"      — triggered when a qualifying payment exceeds threshold_amount on threshold_basis
  //   "turnover_above"     — annual turnover above threshold_amount
  //   "event_based"        — fires on a specific event (hiring, listing, etc.)
  trigger_kind       String    @default("always")
  threshold_amount   Decimal?  @db.Decimal(15, 2)
  threshold_basis    String?                             // "per_month_per_payee" | "annual_aggregate" | "single_txn" | "annual_turnover"

  // Structured scope that maps 1:1 to the existing RuleConditions type.
  // Keeping it JSON so adding a new condition (e.g., "isSection8") never
  // needs a migration.
  entity_scope       Json      @default("{}")

  // Provenance
  applicability_reason String?
  notes                String?
  last_verified        DateTime? @db.Date
  verified_by          String?

  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz

  @@index([category])
  @@index([effective_from])
  @@index([effective_to])
  @@index([act])
  @@index([supersedes_rule_id])
  @@map("compliance_rules")
}

// ── Company Facts ─────────────────────────────────────────────────────────
// The ground truth about what a company actually did in a given period.
// One row per atomic fact — e.g., "paid ₹22,000/month rent to M/s Patel
// Estates from 2025-04-01 to 2026-03-31". The applicability evaluator
// reads these rows to decide whether threshold-gated rules apply.
//
// Facts come from three sources: user declarations (onboarding/manage-
// company forms), document extraction (rent agreements, payroll slips,
// contractor invoices), and API pulls (GST portal, MCA filings). The
// `source_kind` + `confidence` fields let the evaluator weight them
// accordingly and ask the user to confirm low-confidence facts.
model CompanyFact {
  id             String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id     String   @db.Uuid

  // Dotted namespace so rules can match fact families without a rigid
  // enum: "rent.monthly_payment", "contractor.annual_spend",
  // "salary.employee_count", "gst.registered_state", "turnover.annual"
  kind           String

  // Period the fact covers. Facts are snapshots for a window — a rent
  // amount for FY25, an employee count as of a certain date, etc.
  period_start   DateTime @db.Date
  period_end     DateTime @db.Date

  // Monetary or numeric value (rupees unless the kind implies otherwise).
  // Null for categorical facts like "gst.registered_state".
  amount         Decimal? @db.Decimal(15, 2)

  // Optional unit override so the evaluator doesn't have to hardcode per-kind.
  unit           String?  // "rupees_per_month" | "rupees_per_year" | "count" | "string"

  // Categorical payload (state name, counterparty, etc.). JSON so a fact
  // can carry richer structure (invoice number, vendor GSTIN) without
  // schema churn.
  payload        Json?

  // Human-friendly identifier of the other party (landlord, contractor)
  // so the evaluator can group by payee when thresholds are per-payee.
  counterparty   String?

  // Where this fact came from.
  source_kind    String   // "user_declared" | "document_extracted" | "api_pull" | "system_derived"
  source_doc_id  String?  @db.Uuid  // link to company_documents row when extracted
  source_ref     String?             // URL/identifier for api_pull / system_derived
  confidence     Float    @default(1.0)  // 0..1 — 1 = explicit user input, lower = inferred

  // Corrections: when a fact is wrong, we insert a new fact and point
  // superseded_by_id at it rather than editing in place. Keeps an
  // audit trail for historical recomputation.
  superseded_by_id String? @db.Uuid

  created_at     DateTime @default(now()) @db.Timestamptz
  created_by     String?  @db.Uuid       // app_user_id of declarer (null for extracted)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz

  @@index([company_id, kind])
  @@index([company_id, period_start, period_end])
  @@index([kind, period_start])
  @@index([source_doc_id])
  @@map("company_facts")
}

// ── Compliance Assessments ────────────────────────────────────────────────
// The evaluator's output: per-company × per-rule × per-financial-year
// decision of whether the rule actually applies, with the reasoning the
// user can read. Tracker UI reads this table (not ComplianceRule directly)
// so thresholds, facts, and user overrides all feed into one surface.
//
// One row per (company, rule_id, financial_year). Re-evaluation updates
// in place and bumps assessed_at; the row keeps a trail of factsCited so
// CAs can audit what the agent saw.
model ComplianceAssessment {
  id                String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id        String   @db.Uuid
  rule_id           String                      // references compliance_rules.id (string key)
  financial_year    String                      // "2026-27" etc.

  applicable        Boolean                     // tracker shows the item iff this is true
  reasoning         String                      // 1-3 sentences, cites fact ids
  confidence        Float    @default(1.0)      // 0..1 — lower for LLM-assisted decisions
  evaluator_kind    String                      // "deterministic" | "llm_assisted" | "user_override"

  facts_cited       String[] @default([])       // CompanyFact ids the decision used

  // User override — takes precedence over any re-evaluation until cleared.
  user_overridden   Boolean  @default(false)
  user_override_note String?
  overridden_by     String?  @db.Uuid           // app_user_id of the overrider
  overridden_at     DateTime? @db.Timestamptz

  assessed_at       DateTime @default(now()) @db.Timestamptz
  assessed_by       String   @default("agent:v1")  // "agent:<version>" | "user:<id>"

  @@unique([company_id, rule_id, financial_year])
  @@index([company_id, financial_year])
  @@index([rule_id])
  @@map("compliance_assessments")
}

// ── Compliance Filing Register ────────────────────────────────────────────
// The operational layer: what actually happened with each compliance item
// for each period. ComplianceAssessment says "does this apply?";
// ComplianceFiling says "was it filed, when, how much, with what docs?"
//
// One row per (company, rule, period). period_key is the granularity key:
//   monthly  → "2026-04"
//   quarterly → "2026-Q1"
//   annual    → "2026-27"
//   half-yearly → "2026-H1"
//   one-time  → "once"
//
// The tracker UI reads from this table. The evaluator seeds rows for
// every applicable assessment. Users + the vault agent update them as
// filings happen.
model ComplianceFiling {
  id                String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id        String    @db.Uuid
  rule_id           String                       // references compliance_rules.id
  assessment_id     String?   @db.Uuid           // references compliance_assessments.id
  financial_year    String
  period_key        String                       // "2026-04" | "2026-Q1" | "2026-27" | "once"

  // Due date — computed from the rule's due_date_formula
  due_date          DateTime? @db.Date

  // Status
  status            String    @default("pending") // pending | filed | overdue | partially_filed | not_due

  // Financial columns from the CA's compliance tracker spreadsheet
  amount_payable    Decimal?  @db.Decimal(15, 2)
  amount_paid       Decimal?  @db.Decimal(15, 2)
  short_deduction   Decimal?  @db.Decimal(15, 2)

  // Dates
  date_of_payment   DateTime? @db.Date
  date_of_filing    DateTime? @db.Date
  days_delay        Int?                         // auto: date_of_filing - due_date (positive = late)

  // Interest / penalty (auto-computed or manual override)
  interest_on_short Decimal?  @db.Decimal(15, 2)
  interest_on_late  Decimal?  @db.Decimal(15, 2)

  // References
  challan_number    String?
  acknowledgement   String?                      // ACK number, SRN, filing ref
  form_reference    String?                      // Form 16, Form 131, Form 168, etc.
  working_notes     String?                      // free-text computation / working

  // Document linkage — filled when user uploads from tracker or agent maps a vault doc
  document_id       String?   @db.Uuid           // references company_documents_internal.id

  // Audit
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid

  @@unique([company_id, rule_id, period_key])
  @@index([company_id, financial_year])
  @@index([company_id, status])
  @@index([rule_id])
  @@index([document_id])
  @@map("compliance_filings")
}

model CiaConversation {
  id         String       @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id String       @db.Uuid
  user_id    String       @db.Uuid
  name       String       @default("New Chat")
  created_at DateTime     @default(now()) @db.Timestamptz
  updated_at DateTime     @default(now()) @db.Timestamptz
  messages   CiaMessage[]

  @@map("cia_conversations")
}

model CiaMessage {
  id              String          @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  conversation_id String          @db.Uuid
  role            String          @db.VarChar(10)
  content         String
  sources         Json?
  created_at      DateTime        @default(now()) @db.Timestamptz
  conversation    CiaConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("cia_messages")
}

model CompanyNotification {
  id             String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id     String    @db.Uuid
  user_id        String?   @db.Uuid  // Nullable for Passport users (use app_user_id instead)
  app_user_id    String?   @db.Uuid  // For Passport users
  type           String
  title          String
  message        String
  requirement_id String?   @db.Uuid
  document_id    String?   @db.Uuid
  is_read        Boolean?  @default(false)
  read_at        DateTime? @db.Timestamptz
  created_at     DateTime? @default(now()) @db.Timestamptz
  metadata       Json?

  company     Company @relation(fields: [company_id], references: [id])
  requirement RegulatoryRequirement? @relation(fields: [requirement_id], references: [id])

  @@map("company_notifications")
}

model RegulatoryRequirement {
  id                  String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id          String    @db.Uuid
  category            String
  requirement         String
  description         String?
  status              String    @default("not_started")
  due_date            DateTime? @db.Date
  penalty             String?
  is_critical         Boolean?  @default(false)
  // Indian financial-year label ("2026-27"). Present in prod DB but
  // was missing from this model for a long time, which forced callers
  // to use raw SQL for any FY filter. Added here so Prisma stops
  // trying to drop it and so queries can use the Prisma API.
  financial_year      String?
  created_at          DateTime? @default(now()) @db.Timestamptz
  updated_at          DateTime? @default(now()) @db.Timestamptz
  created_by          String?   @db.Uuid
  updated_by          String?   @db.Uuid
  app_created_by      String?   @db.Uuid
  app_updated_by      String?   @db.Uuid
  template_id         String?   @db.Uuid
  compliance_type     String?
  entity_type         String?
  industry            String?
  industry_category   String?
  filed_on            DateTime? @db.Date
  filed_by            String?   @db.Uuid
  app_filed_by        String?   @db.Uuid
  status_reason       String?
  possible_legal_action String?
  penalty_config      Json?
  penalty_base_amount Decimal?  @db.Decimal(15, 2)
  required_documents  String[]
  year_type           String?
  country_code        String?
  // AI compliance intelligence fields
  source              String?   @default("manual")
  confidence_score    Float?
  needs_ca_review     Boolean?  @default(false)
  source_url          String?
  act                 String?
  section             String?
  authority           String?
  due_date_formula    String?
  applicability_reason String?
  ai_batch_id         String?
  period_key          String?
  period_label        String?
  // Filing fields — user provides payable/paid/document inline in list view.
  // Everything else (delay, interest, short) is auto-computed for display.
  amount_payable      Decimal?  @db.Decimal(15, 2)
  amount_paid         Decimal?  @db.Decimal(15, 2)
  filing_document_id  String?   @db.Uuid

  company              Company @relation(fields: [company_id], references: [id])
  companyNotifications CompanyNotification[]

  @@map("regulatory_requirements")
}

model Director {
  id             String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id     String    @db.Uuid
  first_name     String?
  last_name      String?
  middle_name    String?
  director_id    String?   @map("director_id")
  designation    String?
  dob            DateTime? @db.Timestamptz
  tax_id         String?
  email          String?
  mobile         String?
  is_verified    Boolean?  @default(false)
  source         String?   @default("manual")
  created_at     DateTime? @default(now()) @db.Timestamptz
  metadata       Json?

  @@map("directors")
}

model Payment {
  id                  String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  user_id             String    @db.Uuid
  app_user_id         String?   @db.Uuid
  company_id          String?   @db.Uuid
  provider_order_id   String    @unique
  provider_payment_id String?
  provider_signature  String?
  payment_provider    String
  amount              Decimal   @db.Decimal(15, 2)
  amount_paid         Decimal?  @db.Decimal(15, 2)
  currency            String    @default("INR")
  status              String    @default("pending")
  tier                String
  billing_cycle       String
  receipt             String?
  payment_method      String?
  notes               Json?
  paid_at             DateTime? @db.Timestamptz
  error_code          String?
  error_description   String?
  refund_status       String?
  refund_scheduled_at DateTime? @db.Timestamptz
  refunded_at         DateTime? @db.Timestamptz
  refund_amount       Decimal?  @db.Decimal(15, 2)
  payment_type        String?
  // Raw provider response (Razorpay webhook payload etc.) — kept as
  // JSON so we can reconcile against the provider after the fact.
  provider_metadata   Json?
  created_at          DateTime? @default(now()) @db.Timestamptz
  updated_at          DateTime? @default(now()) @db.Timestamptz

  @@map("payments")
}

model Subscription {
  id                    String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  user_id               String    @db.Uuid
  app_user_id           String?   @db.Uuid
  company_id            String?   @db.Uuid
  subscription_type     String?   @default("company")
  status                String    @default("active")
  tier                  String
  billing_cycle         String?   @default("monthly")
  amount                Decimal?  @db.Decimal(15, 2)
  currency              String?   @default("INR")
  payment_provider      String?
  provider_subscription_id String?
  start_date            DateTime  @db.Timestamptz
  end_date              DateTime  @db.Timestamptz
  current_period_start  DateTime? @db.Timestamptz
  current_period_end    DateTime? @db.Timestamptz
  cancel_at_period_end  Boolean?  @default(false)
  cancelled_at          DateTime? @db.Timestamptz
  is_trial              Boolean?  @default(false)
  trial_started_at      DateTime? @db.Timestamptz
  trial_ends_at         DateTime? @db.Timestamptz
  // Raw provider webhook payload for the subscription lifecycle.
  provider_metadata     Json?
  created_at            DateTime? @default(now()) @db.Timestamptz
  updated_at            DateTime? @default(now()) @db.Timestamptz

  @@map("subscriptions")
}

model EmailPreference {
  id                         String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  user_id                    String    @unique @db.Uuid
  app_user_id                String?   @db.Uuid
  unsubscribe_status_changes Boolean   @default(false)
  unsubscribe_reminders      Boolean   @default(false)
  unsubscribe_team_updates   Boolean   @default(false)
  unsubscribe_all            Boolean   @default(false)
  digest_frequency           String    @default("daily")
  created_at                 DateTime? @default(now()) @db.Timestamptz
  updated_at                 DateTime? @default(now()) @db.Timestamptz

  @@map("email_preferences")
}

model UserRole {
  id          String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  user_id     String?   @db.Uuid  // Nullable for Passport users (use app_user_id instead)
  app_user_id String?   @db.Uuid  // For Passport users
  company_id  String?   @db.Uuid
  role        String
  created_at  DateTime? @default(now()) @db.Timestamptz
  updated_at  DateTime? @default(now()) @db.Timestamptz

  @@map("user_roles")
}

model TeamInvitation {
  id                  String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id          String    @db.Uuid
  email               String
  role                String
  token               String    @unique
  invited_by          String    @db.Uuid
  created_at          DateTime? @default(now()) @db.Timestamptz
  expires_at          DateTime  @db.Timestamptz
  accepted_at         DateTime? @db.Timestamptz
  accepted_by_user_id String?   @db.Uuid

  @@map("team_invitations")
}

model CompanyDocument {
  id                    String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id            String    @db.Uuid
  document_type         String?
  folder_name           String?                            // legacy — kept for back-compat until fully migrated
  folder_id             String?   @db.Uuid                 // new: FK to vault_folders
  file_path             String
  file_name             String?
  registration_date     DateTime? @db.Date
  expiry_date           DateTime? @db.Date
  is_portal_required    Boolean?  @default(false)
  portal_email          String?
  portal_password       String?
  frequency             String?
  embedding             Unsupported("vector")?
  period_type           String?
  period_financial_year String?
  period_key            String?
  period_start          DateTime? @db.Date
  period_end            DateTime? @db.Date
  requirement_id        String?   @db.Uuid

  // Version chain — replaces the old "group by created_at" heuristic.
  // When the user uploads a replacement, we insert a new row and point
  // its parent_document_id at the old one, then mark the old row
  // is_latest = false. Keeps full history; UI can walk the chain.
  parent_document_id    String?   @db.Uuid
  version_number        Int       @default(1)
  is_latest             Boolean   @default(true)

  // Soft delete so references from assessments/filings survive but the
  // document drops out of tracker + vault views.
  deleted_at            DateTime? @db.Timestamptz

  // Draft state — the Document Intelligence Agent creates a row as soon
  // as the file is uploaded, runs analysis, and returns suggestions. The
  // row stays `is_draft = true` until the user confirms (or edits) the
  // suggestions; the vault + tracker views ignore drafts. Existing rows
  // keep the default `false` so the migration is a no-op for them.
  is_draft              Boolean   @default(false)

  // Agent suggestions waiting for user confirmation on a draft. JSON so
  // the shape can evolve without a migration; emptied on finalize.
  agent_suggestions     Json?

  created_at            DateTime? @default(now()) @db.Timestamptz
  created_by            String?   @db.Uuid
  updated_at            DateTime? @default(now()) @db.Timestamptz

  @@index([company_id, folder_id])
  @@index([parent_document_id])
  @@index([company_id, is_latest, deleted_at])
  @@index([company_id, is_draft])
  @@map("company_documents_internal")
}

// ── Document Ingest Job Queue ────────────────────────────────────────────
// Background queue for the smart-ingest pipeline. Vault & onboarding
// uploads create the CompanyDocument row immediately as dumb storage,
// then enqueue a job here. A Supabase pg_cron tick fires every 30s,
// pg_net POSTs to /api/jobs/run-ingest, which claims up to 3 pending
// rows per company via SELECT … FOR UPDATE SKIP LOCKED, runs the AI
// agent (analyzeAndStoreSuggestion), resolves the matching tracker
// requirement, and either auto-links the doc (status=linked) or marks
// it needs_review for the user to confirm in the vault sidebar.
//
// Concurrency rationale: 3 per company keeps Azure OpenAI TPM at
// ~15k/min (3 × ~5k tokens), well inside the safe envelope, and
// leaves headroom for synchronous tracker uploads happening at the
// same time. Jobs across companies run in parallel.
//
// Status transitions:
//   pending → extracting → matching → linked
//                                  → needs_review
//                       → failed (on error; retried up to 3 times)
model DocumentIngestJob {
  id           String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  document_id  String    @db.Uuid
  company_id   String    @db.Uuid
  source       String                                      // 'vault' | 'tracker' | 'onboarding'
  status       String    @default("pending")               // 'pending' | 'extracting' | 'matching' | 'linked' | 'needs_review' | 'failed'
  attempts     Int       @default(0)
  last_error   String?
  result       Json?                                        // { suggestion, resolvedRequirementId, confidence }
  enqueued_at  DateTime  @default(now()) @db.Timestamptz
  started_at   DateTime? @db.Timestamptz
  finished_at  DateTime? @db.Timestamptz
  worker_id    String?                                     // for liveness debugging

  @@index([company_id, status])
  @@index([status, enqueued_at])
  @@map("document_ingest_jobs")
}

// ── Vault Folder Tree ─────────────────────────────────────────────────────
// A per-company folder hierarchy. Seeded system folders (kind = "system")
// implement the PRD v1.1 §2.2 / §3.1 taxonomy:
//   Top-level (5): Constitutional Docs, Licences, Statutory Compliances,
//                  Financials, MCA Filings
//   Constitutional Docs nested (7): MOA, AOA, COI, PAN, TAN,
//                  Share Certificates, DIN Certificates
//   Statutory Compliances nested (5): Advance Tax, TDS, ITR Computation
//                  & Acknowledgement, Tax Audit, GST
// User-created folders (kind = "user") can be added anywhere — at the
// top level or nested under any existing folder. The document-intelligence
// agent picks the best match at upload time; users can override.
model VaultFolder {
  id           String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  company_id   String   @db.Uuid
  parent_id    String?  @db.Uuid                 // null = top-level
  slug         String                             // "constitutional", "moa", "tds" — stable machine id
  name         String                             // display name
  kind         String   @default("user")          // "system" | "user"
  sort_order   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz

  @@unique([company_id, parent_id, slug])
  @@index([company_id, parent_id])
  @@map("vault_folders")
}

