# ============================================================
# Finacra Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# --- Core (REQUIRED) ---
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"
SESSION_SECRET="generate-a-random-64-char-string"

# --- Supabase (REQUIRED) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Google OAuth (REQUIRED) ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Site URLs (optional, has fallbacks) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PASSPORT_CALLBACK_URL="http://localhost:3000/auth/callback"

# --- Razorpay (required in production) ---
# Use TEST keys in development/preview, LIVE keys in production only
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Azure OpenAI (required for CIA/AI features) ---
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-5.2-chat"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=""

# --- Azure Speech (optional, for TTS) ---
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
AZURE_SPEECH_VOICE=""

# --- Azure Document Intelligence (optional) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_KEY=""

# --- KYC Verification (optional, for CIN/DIN lookup) ---
KYC_API_TOKEN_ID=""
KYC_API_TOKEN_SECRET=""

# --- AI Research (optional) ---
TAVILY_API_KEY=""
PERPLEXITY_API_KEY=""

# --- Email (optional, for notifications) ---
RESEND_API_KEY=""

# --- Cron Jobs (required in production) ---
CRON_SECRET=""

# --- Storage (optional, defaults to supabase) ---
# STORAGE_PROVIDER="supabase"
# STORAGE_BUCKET="company-documents"

# --- Feature Flag Overrides (optional) ---
# FEATURE_SEBI_COMPLIANCE=true
# FEATURE_CIA_V2=true
# FEATURE_MULTI_COUNTRY=true
# FEATURE_REAL_TIME_NOTIFICATIONS=true
# FEATURE_ADVANCED_REPORTS=true
# FEATURE_BULK_UPLOAD_V2=true
